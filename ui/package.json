{
  "name": "taotie-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "cd .. && tauri",
    "taotie:dev": "cd .. && tauri dev --config src-tauri/tauri.conf.json",
    "taotie:build": "cd .. && tauri build --config src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.6.0",
    "@types/node": "^26.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
