        "downloadstring",
        "downloadfile",
        "invoke-webrequest",
        "net.webclient",
        "start-bitstransfer",
        "iex(",
        "invoke-expression"
      ],
      "condition": "ps and dl"
    }
  },
  {
    "id": "sigma-run-key-persistence",
    "title": "Run キーによる永続化 (T1547.001)",
    "level": "high",
    "description": "レジストリ Run/RunOnce キーへの登録による自動起動の永続化。reg add や *-ItemProperty でユーザ/マシンのログオン時実行を仕込む。登録値と実行先を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1547/001/"
    ],
    "falsepositives": [
      "アプリの自動起動登録(正規インストーラ)"
    ],
    "tags": [
      "attack.t1547.001",
      "attack.persistence"
    ],
    "detection": {
      "key": [
        "currentversion\\run",
        "currentversion\\runonce"
      ],
      "op": [
        "reg add",
        "reg.exe add",
        "new-itemproperty",
        "set-itemproperty"
      ],
      "condition": "key and op"
    }
  },
  {
    "id": "sigma-defender-exclusion",
