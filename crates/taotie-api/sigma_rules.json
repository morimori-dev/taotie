    ]
  },
  {
    "id": "sigma-disable-defender",
    "title": "Windows Defender の無効化 (T1562.001)",
    "level": "high",
    "tags": [
      "attack.t1562.001",
      "attack.defense_evasion"
    ],
    "detection": {
      "cmd": [
        "set-mppreference",
        "add-mppreference"
      ],
      "act": [
        "disable",
        "-exclusionpath",
        "-exclusionextension"
      ],
      "condition": "cmd and act"
    },
    "description": "Windows Defender の無効化(リアルタイム保護 OFF、Set-MpPreference、該当レジストリ変更等)。防御回避のため EDR/AV を停止する典型手口で、直後に悪性ペイロードが実行される可能性が高い。",
    "references": [
      "https://attack.mitre.org/techniques/T1562/001/"
    ],
    "falsepositives": [
      "検証・トラブルシュートのための一時的な無効化(変更管理記録と突合)"
    ]
  },
  {
    "id": "sigma-mimikatz-indicators",
    "title": "Mimikatz の痕跡 (T1003)",
    "level": "critical",
    "tags": [
      "attack.t1003",
      "attack.credential_access"
    ],
    "detection": {
      "keywords": [
        "sekurlsa",
        "privilege::debug",
        "lsadump",
        "dumpcreds",
        "kerberos::",
        "crypto::",
        "gentilkiwi"
      ],
      "condition": "keywords"
    },
    "description": "Mimikatz 特有の文字列/挙動(sekurlsa::logonpasswords, privilege::debug 等)。資格情報窃取ツールの実行痕跡で、LSASS からの資格情報抽出が行われた可能性が高い。実行元と時刻を軸に横展開を追跡する。",
    "references": [
      "https://attack.mitre.org/techniques/T1003/",
      "https://github.com/gentilkiwi/mimikatz"
    ],
    "falsepositives": [
      "セキュリティ検証・レッドチーム演習(実施記録と突合)"
    ]
  },
  {
    "id": "sigma-schtasks-create",
    "title": "schtasks による永続化/実行 (T1053.005)",
    "level": "high",
    "description": "schtasks.exe による スケジュールタスクの作成。攻撃者が永続化や遅延実行、SYSTEM 権限での実行に多用する。作成されたタスク名・実行コマンド・トリガを確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1053/005/"
    ],
    "falsepositives": [
      "ソフトウェア導入や管理スクリプトによる正規のタスク作成"
    ],
    "tags": [
      "attack.t1053.005",
      "attack.execution"
    ],
    "detection": {
      "tool": [
        "schtasks"
      ],
      "act": [
        "/create",
        "-create"
      ],
      "condition": "tool and act"
    }
  },
  {
    "id": "sigma-certutil-download",
    "title": "certutil によるファイルダウンロード (T1105)",
    "level": "high",
    "description": "certutil.exe の urlcache 機能を悪用したリモートファイルの取得。LOLBin による検知回避付きダウンロードで、ペイロード配布の典型。取得元 URL と保存先を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1105/",
      "https://lolbas-project.github.io/lolbas/Binaries/Certutil/"
    ],
    "falsepositives": [
      "証明書関連の正規運用(urlcache 併用は稀)"
    ],
    "tags": [
      "attack.t1105",
      "attack.command_and_control"
    ],
    "detection": {
      "tool": [
        "certutil"
      ],
      "dl": [
        "urlcache",
        "-split -f",
        "verifyctl"
      ],
      "condition": "tool and dl"
    }
  },
  {
    "id": "sigma-bitsadmin-transfer",
    "title": "bitsadmin によるダウンロード (T1197)",
    "level": "high",
    "description": "bitsadmin.exe による BITS ジョブ経由のファイル転送。バックグラウンド転送で検知を回避しつつペイロードを取得する手口。転送元/先を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1197/",
      "https://lolbas-project.github.io/lolbas/Binaries/Bitsadmin/"
    ],
    "falsepositives": [
      "更新配布等の正規 BITS 利用"
    ],
    "tags": [
      "attack.t1197",
      "attack.t1105",
      "attack.defense_evasion"
    ],
    "detection": {
      "tool": [
        "bitsadmin"
      ],
      "act": [
        "/transfer",
        "/addfile",
        "/download"
      ],
      "condition": "tool and act"
    }
  },
  {
    "id": "sigma-shadowcopy-delete",
    "title": "ボリュームシャドウコピーの削除 (T1490)",
    "level": "critical",
    "description": "vssadmin / wmic / wbadmin によるシャドウコピー・バックアップの削除。復旧を妨害するランサムウェアの常套手段で、暗号化直前に実行されることが多い。実行元と時刻を軸に前後を追跡する。",
    "references": [
      "https://attack.mitre.org/techniques/T1490/"
    ],
    "falsepositives": [
      "バックアップ製品による正規のシャドウ管理(稀)"
    ],
    "tags": [
      "attack.t1490",
      "attack.impact"
    ],
    "detection": {
      "del": [
        "vssadmin delete shadows",
        "shadowcopy delete",
        "wbadmin delete catalog",
        "win32_shadowcopy",
        "delete shadows /all"
      ],
      "condition": "del"
    }
  },
  {
    "id": "sigma-mshta-suspicious",
    "title": "mshta によるリモート/スクリプト実行 (T1218.005)",
    "level": "high",
    "description": "mshta.exe による HTA/スクリプトの実行。リモート HTA や javascript:/vbscript: を用いて任意コードを正規プロセス経由で実行し検知を回避する。呼び出し先を精査する。",
    "references": [
      "https://attack.mitre.org/techniques/T1218/005/",
      "https://lolbas-project.github.io/lolbas/Binaries/Mshta/"
    ],
    "falsepositives": [
      "レガシー業務アプリの HTA 利用"
    ],
    "tags": [
      "attack.t1218.005",
      "attack.defense_evasion"
    ],
    "detection": {
      "tool": [
        "mshta"
      ],
      "susp": [
        "http://",
        "https://",
        "javascript:",
        "vbscript:",
        ".hta"
      ],
      "condition": "tool and susp"
    }
  },
  {
    "id": "sigma-regsvr32-scrobj",
    "title": "regsvr32 による COM スクリプト/リモート実行 (T1218.010)",
    "level": "high",
    "description": "regsvr32.exe を悪用した scrobj/リモート scriptlet の実行(Squiblydoo)。署名済みバイナリ経由で任意コードを実行し検知を回避する。呼び出された scriptlet を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1218/010/",
      "https://lolbas-project.github.io/lolbas/Binaries/Regsvr32/"
    ],
    "falsepositives": [
      "正規 DLL の登録(scrobj/http 併用は稀)"
    ],
    "tags": [
      "attack.t1218.010",
      "attack.defense_evasion"
    ],
    "detection": {
      "tool": [
        "regsvr32"
      ],
      "susp": [
        "scrobj",
        "/i:http",
        "-i:http",
        "/i:\\\\"
      ],
      "condition": "tool and susp"
    }
  },
  {
    "id": "sigma-wmic-process-call",
    "title": "wmic による遠隔/プロセス実行 (T1047)",
