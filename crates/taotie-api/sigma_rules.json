[
  {
    "id": "sigma-security-log-cleared",
    "title": "セキュリティイベントログの消去 (T1070.001)",
    "level": "high",
    "tags": [
      "attack.t1070.001",
      "attack.defense_evasion"
    ],
    "logsource": {
      "service": "security"
    },
    "detection": {
      "selection": {
        "EventID": "1102"
      },
      "condition": "selection"
    },
    "description": "Security イベントログが消去された際に記録される EventID 1102。攻撃者が侵害後の痕跡を隠すためにログを消すアンチフォレンジックの典型で、正規運用でログ全消去は稀。消去の直前後のアクティビティを重点調査する。",
    "references": [
      "https://attack.mitre.org/techniques/T1070/001/",
      "https://learn.microsoft.com/windows/security/threat-protection/auditing/event-1102"
    ],
    "falsepositives": [
      "監査ログの意図的な再構成やテスト環境でのリセット",
      "SIEM 移行時のログクリア"
    ]
  },
  {
    "id": "sigma-wevtutil-clear-log",
    "title": "wevtutil によるイベントログ消去 (T1070.001)",
    "level": "high",
    "tags": [
      "attack.t1070.001",
      "attack.defense_evasion"
    ],
    "detection": {
      "tool": [
        "wevtutil"
      ],
      "action": [
        "cl ",
        "clear-log",
        "clearlog"
      ],
      "condition": "tool and action"
    },
    "description": "wevtutil.exe の cl / clear-log によるイベントログ消去をプロセス実行(4688 / Sysmon 1)のコマンドラインから検出。ログ消去による証跡破壊の兆候で、対象チャネル名から何を隠そうとしたかが分かる。",
    "references": [
      "https://attack.mitre.org/techniques/T1070/001/",
      "https://lolbas-project.github.io/lolbas/Binaries/Wevtutil/"
    ],
    "falsepositives": [
      "管理者による意図的なログ整理・容量対策"
    ]
  },
  {
    "id": "sigma-comsvcs-lsass-minidump",
    "title": "comsvcs.dll MiniDump による LSASS ダンプ (T1003.001)",
    "level": "critical",
    "tags": [
      "attack.t1003.001",
      "attack.credential_access"
    ],
    "detection": {
      "dll": [
        "comsvcs"
      ],
      "func": [
        "minidump"
      ],
      "condition": "dll and func"
    },
    "description": "comsvcs.dll の MiniDump 関数を rundll32 経由で呼び出し、LSASS プロセスのメモリをダンプする資格情報窃取の常套手段。ダンプから平文パスワード/ハッシュ/Kerberos チケットが抽出される。正規運用でこの呼び出しはほぼ発生しない。",
    "references": [
      "https://attack.mitre.org/techniques/T1003/001/",
      "https://lolbas-project.github.io/lolbas/Libraries/Comsvcs/"
    ],
    "falsepositives": [
      "ほぼ無し。EDR/クラッシュ解析ツールが同等 API を使う場合のみ要確認"
    ]
  },
  {
    "id": "sigma-ntds-extraction",
    "title": "NTDS.dit 抽出 (T1003.003)",
    "level": "critical",
    "tags": [
      "attack.t1003.003",
      "attack.credential_access"
    ],
    "detection": {
      "ntdsutil": [
        "ntdsutil"
      ],
      "ntdsfile": [
        "ntds.dit"
      ],
      "condition": "1 of them"
    },
    "description": "ドメインコントローラの資格情報データベース NTDS.dit の抽出(ntdsutil / VSS スナップショット経由のコピー等)。取得されると全ドメインアカウントのハッシュが漏れ、DCSync 相当のドメイン全体侵害に直結する。",
    "references": [
      "https://attack.mitre.org/techniques/T1003/003/",
      "https://learn.microsoft.com/windows-server/administration/windows-commands/ntdsutil"
    ],
    "falsepositives": [
      "正規の Active Directory バックアップ/リストア運用"
    ]
  },
  {
    "id": "sigma-psexec-service",
    "title": "PsExec 系サービスによる遠隔実行 (T1569.002)",
    "level": "high",
    "tags": [
      "attack.t1569.002",
      "attack.execution"
    ],
    "detection": {
      "svc": [
        "psexesvc",
        "paexec",
        "remcomsvc"
      ],
      "condition": "svc"
    },
    "description": "PsExec 系ツールが遠隔実行のために作成する一時サービス(PSEXESVC 等)のインストール(EventID 7045)。横展開(lateral movement)や遠隔コマンド実行の兆候。サービス名・実行元ホストを相関して侵害範囲を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1569/002/",
      "https://learn.microsoft.com/sysinternals/downloads/psexec"
    ],
    "falsepositives": [
      "管理者による PsExec の正規利用(運用自動化・IT サポート)"
    ]
  },
  {
    "id": "sigma-encoded-powershell",
    "title": "エンコード済み PowerShell 実行 (T1059.001)",
    "level": "high",
    "tags": [
      "attack.t1059.001",
      "attack.execution"
    ],
    "detection": {
      "ps": [
        "powershell",
        "pwsh"
      ],
      "enc": [
        "-enc",
        "-encodedcommand",
        "frombase64string",
        "-e jab",
        "-ec "
      ],
      "condition": "ps and enc"
    },
    "description": "-EncodedCommand (-enc) で Base64 難読化した PowerShell の実行。検知回避・難読化の典型で、ダウンローダやインメモリ実行など悪性スクリプトに多用される。デコードしたコマンド内容の確認が必須。",
    "references": [
      "https://attack.mitre.org/techniques/T1059/001/"
    ],
    "falsepositives": [
      "一部の正規管理スクリプト/インストーラが -enc を使用することがある"
    ]
  },
  {
    "id": "sigma-rundll32-suspicious",
    "title": "疑わしい rundll32 実行 (T1218.011)",
    "level": "medium",
    "tags": [
      "attack.t1218.011",
      "attack.defense_evasion"
    ],
    "detection": {
      "img": [
        "rundll32"
      ],
      "susp": [
        "javascript:",
        "mshtml",
        ",#",
        "url.dll,openurl",
        "shell32.dll,control_rundll"
      ],
      "condition": "img and susp"
    },
    "description": "rundll32.exe による疑わしい DLL 実行(引数の欠落や異常なエクスポート呼び出し等)。LOLBAS を悪用して任意コードを正規プロセス経由で実行し検知を回避する手口。呼び出された DLL とエクスポートを精査する。",
    "references": [
      "https://attack.mitre.org/techniques/T1218/011/",
      "https://lolbas-project.github.io/lolbas/Binaries/Rundll32/"
    ],
    "falsepositives": [
      "正規アプリケーションが rundll32 経由で機能を呼び出す場合"
    ]
  },
  {
    "id": "sigma-kerberoast-rc4",
    "title": "Kerberoasting (RC4 TGS 要求) (T1558.003)",
    "level": "high",
    "tags": [
      "attack.t1558.003",
      "attack.credential_access"
    ],
    "logsource": {
      "service": "security"
    },
    "detection": {
      "selection": {
        "EventID": "4769",
        "TicketEncryptionType": "0x17"
      },
      "filter": {
        "ServiceName|contains": "krbtgt"
      },
      "condition": "selection and not filter"
    },
    "description": "RC4(暗号種別 0x17)の TGS チケット要求(EventID 4769)の多発。サービスアカウントのチケットを取得しオフラインでパスワードを解読する Kerberoasting の兆候。要求元アカウントと対象 SPN を確認する。",
    "references": [
      "https://attack.mitre.org/techniques/T1558/003/"
    ],
    "falsepositives": [
      "RC4 を常用する旧構成環境では誤検知しうる。AES 強制で切り分ける"
    ]
  },
  {
    "id": "sigma-asrep-roast",
    "title": "AS-REP Roasting (事前認証なし) (T1558.004)",
    "level": "high",
    "tags": [
      "attack.t1558.004",
      "attack.credential_access"
    ],
    "logsource": {
      "service": "security"
    },
    "detection": {
      "selection": {
        "EventID": "4768",
        "PreAuthType": "0"
      },
      "condition": "selection"
    },
    "description": "事前認証(Kerberos pre-authentication)が無効なアカウントへの AS-REQ に対する AS-REP。応答からハッシュを取得しオフライン解読する AS-REP Roasting の兆候。DONT_REQ_PREAUTH フラグを持つアカウントを棚卸しする。",
    "references": [
      "https://attack.mitre.org/techniques/T1558/004/"
    ],
    "falsepositives": [
      "互換性のため意図的に pre-auth を無効化した運用アカウント"
    ]
  },
  {
    "id": "sigma-account-created",
    "title": "ユーザーアカウント作成 (T1136.001)",
    "level": "medium",
    "tags": [
      "attack.t1136.001",
      "attack.persistence"
    ],
    "logsource": {
      "service": "security"
    },
    "detection": {
      "selection": {
        "EventID": "4720"
      },
      "condition": "selection"
    },
    "description": "ローカル/ドメインのユーザーアカウント作成(EventID 4720)。攻撃者による永続化用バックドアアカウント作成の可能性。作成者・作成時刻・直後の権限付与を相関して正当性を判断する。",
    "references": [
